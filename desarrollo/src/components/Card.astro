---
export interface Props {
  image: string;
  title: string;
  alt?: string;
}

const { image, title, alt = title } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden">
  <img 
    src={image} 
    alt={alt} 
    class="w-full h-48 object-cover"
  />
  <div class="p-4">
    <h3 class="text-lg font-semibold text-gray-800">
      {title}
    </h3>
  </div>
</div>