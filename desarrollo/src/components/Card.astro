---
export interface Props {
  image: string;
  title: string;
  alt?: string;
  imgHeight?: string;
  imgWidth?: string;
  style?: string;
}

const { image, title, alt = title, imgHeight = "h-48", imgWidth = "w-full", style } = Astro.props;
---

<div class={`bg-whit flex flex-col justify-end rounded-lg shadow-md ${style}`}>
  <img 
    src={image} 
    alt={alt} 
    class={`${imgHeight} ${imgWidth} mx-auto`}
  />
  <div class="p-4">
    <h3 class="text-lg text-center font-semibold text-gray-800">
      {title}
    </h3>
    <slot />
  </div>
</div>