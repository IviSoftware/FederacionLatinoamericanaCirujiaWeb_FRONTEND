---
export interface Props {
  title: string;
  description?: string;
  type: 'youtube' | 'vimeo' | 'video';
  url: string;
  thumbnail?: string;
  duration?: string;
  speaker?: string;
}

const { title, description, type, url, thumbnail, duration, speaker } = Astro.props;
---

<div class="video-card bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
  <div class="relative aspect-video bg-gray-200">
    {type === 'youtube' && (
      <iframe
        class="w-full h-full"
        src={url}
        title={title}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    )}

    {type === 'vimeo' && (
      <iframe
        class="w-full h-full"
        src={url}
        title={title}
        frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
    )}

    {type === 'video' && (
      <video
        class="w-full h-full"
        controls
        preload="metadata"
        poster={thumbnail}
      >
        <source src={url} type="video/mp4" />
        Tu navegador no soporta el elemento de video.
      </video>
    )}

    {duration && (
      <div class="absolute bottom-2 right-2 bg-black bg-opacity-75 text-white text-xs px-2 py-1 rounded">
        {duration}
      </div>
    )}
  </div>

  <div class="p-4">
    <h3 class="text-lg font-bold text-gray-800 mb-2">{title}</h3>

    {speaker && (
      <p class="text-sm text-primaryEvent font-semibold mb-2">
        {speaker}
      </p>
    )}

    {description && (
      <p class="text-sm text-gray-600 line-clamp-2">
        {description}
      </p>
    )}
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
