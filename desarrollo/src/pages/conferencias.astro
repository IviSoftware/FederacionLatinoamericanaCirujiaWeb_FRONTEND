---
import TitleSection from "../components/TitleSection.astro";
import Layout from "../layouts/Layout.astro";
import { Toggle } from "../features/Toggle.tsx";
import CongressCards from "../components/CongressCards.astro";
---

<Layout title="Conferencias">
  <section class="container mx-auto px-4 py-8">
    <TitleSection title="Conferencias FELAC" />

    <div class="max-w-4xl mx-auto">
      <!-- Toggle 1: Cirujano Internacional Distinguido -->
      <Toggle
        title="1.- CONFERENCIA 'CIRUJANO INTERNACIONAL DISTINGUIDO'"
        client:load
        defaultOpen={true}
      >
        <div>
          <div class="px-4 py-4 text-gray-700 leading-relaxed">
            <p class="mb-4">
              En reunión informal del Consejo Asesor de la FELAC en noviembre de
              2004 en la Habana se planteó la necesidad de establecer una
              conferencia llamada "Cirujano Internacional Distinguido" para
              honrar al cirujano de raíces latinoamericanas que en cualquier
              parte del mundo haya sobresalido por sus dotes académicas y haya
              estado vinculado permanentemente a la educación de post grado en
              el continente latinoamericano.
            </p>
            <p class="mb-4">
              Se postuló para la primera conferencia en el 2005, durante el
              congreso de la ciudad de Cartagena al Dr. Marvin J. López oriundo
              de Nicaragua y actualmente Jefe del Departamento de Cirugía de la
              Universidad Tufts de Boston.
            </p>
            <h4 class="font-semibold text-lg mb-3 text-primaryEvent">
              Conferencistas:
            </h4>
            <ul class="space-y-2">
              <li><strong>2005</strong> - Dr. Marvin J. López, Boston</li>
              <li><strong>2007</strong> - Dr. Hugo Villar, Tucson</li>
              <li><strong>2009</strong> - Dr. Carlos Pellegrini, Seattle</li>
              <li><strong>2011</strong> - Dr. Gregorio Sicard, St. Louis</li>
              <li>
                <strong>2013</strong> - Dr. Raúl Rosenthal, Fort Lauderdale
              </li>
              <li><strong>2015</strong> - Dr. Moises Jacobs, Miami</li>
              <li>
                <strong>2017</strong> - Dr. Carlos Fernández del Castillo, Boston
              </li>
              <li><strong>2019</strong> - Dr. Gustavo Plasencia, USA</li>
              <li><strong>2021</strong> - Dr. Diego Camacho, USA</li>
              <li><strong>2023</strong> - Dr. Horacio Asbun, USA</li>
              <li><strong>2025</strong> - Dr. Rubens Sallum</li>
            </ul>
          </div>
        </div>
      </Toggle>

      <!-- Toggle 2: Renato Pacheco Filho -->
      <Toggle title="2.- CONFERENCIAS 'RENATO PACHECO FILHO'" client:load>
        <div>
          <div class="px-4 py-4 text-gray-700 leading-relaxed">
            <p class="mb-4">
              Conferencia Honorífica creada en 1991 en la Asamblea General
              Ordinaria de Ciudad de México para honrar la memoria del Dr.
              Renato Pacheco Filho del Brasil, fundador de la FELAC, gran
              impulsor de la misma y Primer Secretario General o Ejecutivo (1976
              – 1979).
            </p>
            <p class="mb-4">
              Los siguientes han sido los cirujanos latinoamericanos que por su
              vida y su obra han sido honrados con esta distinción:
            </p>
            <h4 class="font-semibold text-lg mb-3 text-primaryEvent">
              Conferencistas:
            </h4>
            <ul class="space-y-2">
              <li><strong>1993</strong> - Dr. José Félix Patiño de Colombia</li>
              <li><strong>1995</strong> - Dr. Jorge Cervantes de México</li>
              <li>
                <strong>1999</strong> - Dr. Eugenio B. Ferreria del Brasil
              </li>
              <li>
                <strong>2001</strong> - Dr. Enrique Beveraggi de la Argentina
              </li>
              <li><strong>2003</strong> - Dr. Hernando Abaúnza de Colombia</li>
              <li><strong>2005</strong> - Dr. Samir Rasslan del Brasil</li>
              <li>
                <strong>2007</strong> - Dr. Alejandro García Gutiérrez de Cuba
              </li>
              <li><strong>2009</strong> - Dr. Juan Lombardi de Chile</li>
              <li><strong>2011</strong> - Dr. Pedro Ferraina de Argentina</li>
              <li><strong>2013</strong> - Dr. Natan Zundel de Colombia</li>
              <li><strong>2015</strong> - Dr. Nassim Tata de Venezuela</li>
              <li><strong>2017</strong> - Dr. Attila Csendes de Chile</li>
              <li><strong>2019</strong> - Dr. Samuel Shuchleib de México</li>
              <li><strong>2021</strong> - Dra. Elena López Gavito de México</li>
              <li><strong>2023</strong> - Dr. Alberto Chousleb de México</li>
              <li><strong>2025</strong> - Dr. Samuel Szomstein</li>
            </ul>
          </div>
        </div>
      </Toggle>

      <!-- Toggle 3: Hernando Abaunza Orjuela -->
      <Toggle title="3.- CONFERENCIA 'HERNANDO ABAUNZA ORJUELA'" client:load>
        <div>
          <div class="px-4 py-4 text-gray-700 leading-relaxed">
            <p class="mb-4">
              En la Asamblea General Ordinaria realizada en el mes de noviembre
              de 2007 en la ciudad de Santiago de Chile, se creó la Conferencia
              Honorífica "Hernando Abaunza Orjuela" en reconocimiento a los
              servicios prestados como Director Ejecutivo y Presidente de la
              FELAC.
            </p>
            <p class="mb-4">
              La asamblea determinó que esta conferencia será siempre dictada
              por un Cirujano del país organizador del Congreso.
            </p>
            <h4 class="font-semibold text-lg mb-3 text-primaryEvent">
              Conferencias:
            </h4>
            <ul class="space-y-2">
              <li>
                <strong>2009</strong> - Dr. Pablo Briceño en Caracas, Venezuela
              </li>
              <li>
                <strong>2011</strong> - Dr. José Antonio Carrasco Rojas en Veracruz,
                México
              </li>
              <li>
                <strong>2013</strong> - Dr. Vicente Gutiérrez en Buenos Aires, Argentina
              </li>
              <li>
                <strong>2015</strong> - Dr. Rafael Sánchez Español en Punta Cana,
                República Dominicana
              </li>
              <li>
                <strong>2017</strong> - Dr. Aurelio Rodríguez en Lima, Perú
              </li>
              <li>
                <strong>2019</strong> - Dra. Sonia Boudrandi en Punta del Este, Uruguay
              </li>
              <li><strong>2021</strong> - Dr. Samir Rasslan, Brasil</li>
              <li><strong>2023</strong> - Dr. William Sánchez, Colombia</li>
              <li><strong>2025</strong> - Dra. Winypeg Arriaza</li>
            </ul>
          </div>
        </div>
      </Toggle>
    </div>
  </section>

  <CongressCards />
</Layout>
